{
  "name": "forge-harness",
  "version": "0.2.0",
  "private": true,
  "description": "BYOK-first AI infrastructure and multi-agent orchestration platform. Your models. Your keys. Your agents.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @forge/api dev",
    "dev:dashboard": "pnpm --filter @forge/dashboard dev",
    "dev:all": "pnpm -r --parallel --filter @forge/api --filter @forge/dashboard dev",
    "dev": "pnpm --filter @forge/dashboard dev",
    "start": "node services/api/dist/index.js",
    "db:generate": "pnpm --filter @forge/database generate",
    "db:migrate": "pnpm --filter @forge/database migrate",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "esbuild": "^0.28.2",
    "rcedit": "^5.0.2",
    "typescript": "^5.6.3"
  }
}
