# Forge Harness Master Key — base64-encoded 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, a master.key file is auto-generated in the data directory (development fallback, chmod 0600).
# FORGE_MASTER_KEY=

# Data directory (SQLite DB, master.key). Default: ~/.forge-harness
# FORGE_DATA_DIR=

# SQLite file location. Default: $FORGE_DATA_DIR/forge-harness.db
# FORGE_DATABASE_PATH=

# API binding. Defaults: host 127.0.0.1 (loopback), port 4789.
# Non-loopback hosts REQUIRE FORGE_API_TOKEN or the server refuses to start.
# FORGE_HOST=127.0.0.1
# FORGE_PORT=4789

# Optional bearer token required for all /api/* requests.
# FORGE_API_TOKEN=

# Serve a different dashboard build than apps/dashboard/dist.
# FORGE_DASHBOARD_DIST=
